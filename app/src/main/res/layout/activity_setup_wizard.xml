<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_splash_window">

    <View
        android:layout_width="280dp"
        android:layout_height="280dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="-80dp"
        android:layout_marginEnd="-48dp"
        android:background="@drawable/bg_splash_orb_primary" />

    <View
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="-56dp"
        android:layout_marginBottom="120dp"
        android:background="@drawable/bg_splash_orb_secondary" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingHorizontal="24dp"
        android:paddingTop="40dp"
        android:paddingBottom="28dp">

        <ViewFlipper
            android:id="@+id/flipper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/page_wifi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_login_panel"
                android:elevation="10dp"
                android:orientation="vertical"
                android:padding="22dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="第 1 步 · 配置 Wi-Fi"
                    android:textColor="@color/white"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="将设备接入网络后才能登录平台。开放网络可留空密码。"
                    android:textColor="#9AB2C8"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tv_wifi_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:text="尚未配置 Wi-Fi"
                    android:textColor="#BBD4EA"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btn_configure_wifi"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_login_input"
                    android:text="配置 Wi-Fi"
                    android:textAllCaps="false"
                    android:textColor="#DCE7F2"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btn_skip_wifi"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="10dp"
                    android:background="@android:color/transparent"
                    android:text="跳过，稍后再配"
                    android:textAllCaps="false"
                    android:textColor="#6F879A"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btn_next"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/bg_login_button"
                    android:text="下一步"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/page_ntp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_login_panel"
                android:elevation="10dp"
                android:orientation="vertical"
                android:padding="22dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="第 2 步 · 系统时间 / NTP"
                    android:textColor="@color/white"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="配置整个 Android 系统使用的 NTP 时间源。测试仅检测服务器，不会修改系统时间。"
                    android:textColor="#9AB2C8"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tv_ntp_capability"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="Device Owner：检测中..."
                    android:textColor="#BBD4EA"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tv_ntp_current_server"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="当前系统 NTP：读取中..."
                    android:textColor="#DCE7F2"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="目标 NTP 服务器"
                    android:textColor="#DCE7F2"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/et_ntp_server"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_login_input"
                    android:hint="例如 192.168.111.240 或 ntp.example.com"
                    android:inputType="textUri"
                    android:paddingHorizontal="14dp"
                    android:singleLine="true"
                    android:textColor="@color/white"
                    android:textColorHint="#6F879A" />

                <Button
                    android:id="@+id/btn_test_ntp"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_login_input"
                    android:text="测试 NTP 服务器"
                    android:textAllCaps="false"
                    android:textColor="#DCE7F2"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btn_apply_ntp"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_login_button"
                    android:text="应用到 Android 系统"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_ntp_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_login_input"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="10dp"
                    android:text="请先测试并应用系统 NTP 配置。"
                    android:textColor="#BBD4EA"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btn_ntp_prev"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="14dp"
                    android:background="@android:color/transparent"
                    android:text="上一步"
                    android:textAllCaps="false"
                    android:textColor="#6F879A"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btn_ntp_next"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_login_button"
                    android:enabled="false"
                    android:text="下一步"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/page_server"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_login_panel"
                android:elevation="10dp"
                android:orientation="vertical"
                android:padding="22dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="第 3 步 · 配置服务器"
                    android:textColor="@color/white"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="填写平台地址与公司 ID，登录后将据此同步设备配置。"
                    android:textColor="#9AB2C8"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:text="Base URL"
                    android:textColor="#DCE7F2"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/et_base_url"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_login_input"
                    android:hint="http://host:port"
                    android:inputType="textUri"
                    android:paddingHorizontal="14dp"
                    android:singleLine="true"
                    android:textColor="@color/white"
                    android:textColorHint="#6F879A" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Company ID"
                    android:textColor="#DCE7F2"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/et_company_id"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_login_input"
                    android:hint="公司 ID"
                    android:inputType="number"
                    android:paddingHorizontal="14dp"
                    android:singleLine="true"
                    android:textColor="@color/white"
                    android:textColorHint="#6F879A" />

                <TextView
                    android:id="@+id/tv_error"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_login_error"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="10dp"
                    android:textColor="#FFD5D5"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/btn_prev"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="18dp"
                    android:background="@android:color/transparent"
                    android:text="上一步"
                    android:textAllCaps="false"
                    android:textColor="#6F879A"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btn_finish"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_login_button"
                    android:text="完成并登录"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </ViewFlipper>
    </ScrollView>
</FrameLayout>
